VERSION=latest
NOVACRON_LOG_LEVEL=info
NOVACRON_API_PORT=8091
NOVACRON_WS_PORT=8093
NOVACRON_METRICS_PORT=9090
NOVACRON_FRONTEND_PORT=8080

POSTGRES_DB=novacron
POSTGRES_USER=novacron
POSTGRES_PASSWORD=novacron
NOVACRON_DATABASE_URL=postgres://novacron:novacron@postgres:5432/novacron?sslmode=disable
NOVACRON_REDIS_URL=redis://redis:6379/0

NEXT_PUBLIC_API_URL=http://localhost:8091
NEXT_PUBLIC_WS_URL=ws://localhost:8093
