# NovaCron Frontend Production Dockerfile (build context: ./frontend)
#
# Same runtime shape as docker/frontend.Dockerfile (whose context is the repo
# root): the Next.js app is served by `next start` on port 3000 as uid 1001.
# frontend/next.config.js does not enable `output: 'standalone'`, so the full
# .next build plus node_modules is shipped. The app has no nginx layer and no
# /health route; probe `/`.

# Build stage
FROM node:18-alpine AS builder

WORKDIR /app

# Optional API origin baked into the browser bundle. Empty = same origin
# (lib/api/origin.ts falls back to window.location.origin and derives the
# WebSocket origin from it, so there is no separate WS variable).
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL:-}

COPY package.json package-lock.json* ./

# Dev dependencies are needed for `next build` (typescript, tailwind, ...).
RUN npm ci --no-audit --no-fund

COPY . .

ENV NODE_ENV=production
RUN npm run build

# Production stage
FROM node:18-alpine AS runner

WORKDIR /app

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

ENV NODE_ENV=production \
    PORT=3000 \
    NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL:-}

COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next ./.next
COPY --from=builder --chown=nextjs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nextjs:nodejs /app/package.json ./package.json

USER nextjs

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD wget -q -O /dev/null http://localhost:3000/ || exit 1

EXPOSE 3000

CMD ["npm", "start"]
