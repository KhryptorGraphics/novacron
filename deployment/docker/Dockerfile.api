# NovaCron API Server Production Dockerfile
# Multi-stage build: api-server (root module) + migrate tool (database module).

# Build stage: canonical api-server (backend/cmd/api-server)
FROM golang:1.25-alpine AS builder

RUN apk add --no-cache git ca-certificates tzdata

WORKDIR /build

# go.mod replaces several modules with local directories (backend/core,
# backend/core/orchestration, backend/pkg/logger, sdk/go, ...), so those trees
# must be present before `go mod download` (same as docker/api.Dockerfile).
COPY go.mod go.sum ./
COPY sdk ./sdk
COPY backend ./backend

RUN go mod download

# CGO off (pure-Go build, same as docker/api.Dockerfile); GOARCH follows the
# build platform so arm64 hosts / buildx --platform work.
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -a \
    -o /build/api-server ./backend/cmd/api-server

# Build stage: migration tool. database/migrate.go is its own Go module
# (database/go.mod) with the canonical migrations embedded, so it cannot be
# built from the root-module stage above (mirrors docker/migrate.Dockerfile).
FROM golang:1.25-alpine AS migrate-builder

RUN apk add --no-cache git

WORKDIR /build/database

COPY database/go.mod database/go.sum ./
RUN go mod download

COPY database ./

RUN CGO_ENABLED=0 GOOS=linux go build -a -o /build/bin/migrate .

# Production stage
FROM alpine:3.18

RUN apk add --no-cache \
    ca-certificates \
    tzdata \
    postgresql-client \
    curl \
    && rm -rf /var/cache/apk/*

# Create non-root user
RUN addgroup -g 1000 novacron \
    && adduser -u 1000 -G novacron -s /bin/sh -D novacron

# Create required directories
RUN mkdir -p /app /var/lib/novacron /var/log/novacron \
    && chown -R novacron:novacron /app /var/lib/novacron /var/log/novacron

# Copy built binaries
COPY --from=builder /build/api-server /app/api-server
COPY --from=migrate-builder /build/bin/migrate /app/migrate

RUN chmod +x /app/api-server /app/migrate

USER novacron

WORKDIR /app

# The api-server serves REST and WebSocket on the single API_PORT listener
# (default 8090) and registers GET /health.
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8090/health || exit 1

EXPOSE 8090

# Migrations: `/app/migrate -direction=up` with DB_URL set (see the k8s
# initContainer in deployment/kubernetes/deployments.yaml).
CMD ["./api-server"]
