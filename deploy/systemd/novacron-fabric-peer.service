[Unit]
Description=NovaCron fabric peer (compute-node role: cluster membership, jobs, migrations)
Documentation=file:///opt/novacron/deploy/README.md
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=novacron
Group=novacron
# See novacron-api-server.service: the qemu children this unit spawns need
# /dev/kvm, which is group-owned (root:kvm 0660).
SupplementaryGroups=kvm
WorkingDirectory=/opt/novacron
# The fabric peer role is served by the same api-server binary — the repo has
# one binary for both roles. 9000 matches the repo's own fabric convention
# (config.VMConfig.HypervisorAddrs defaults to localhost:9000) and keeps a
# compute-only node from colliding with a control plane on the same host.
# EnvironmentFile wins, so /etc/novacron/novacron.env still has the last word.
Environment=API_PORT=9000
Environment=WS_PORT=9001
EnvironmentFile=/etc/novacron/novacron.env
ExecStart=/opt/novacron/bin/api-server

# --- hardening that holds for this workload ---
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/novacron /var/log/novacron
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# --- deliberately absent: same list and reasons as novacron-api-server.service
# (qemu shares this cgroup, so no MemoryMax/CPUQuota; PrivateDevices and
# MemoryDenyWriteExecute would break /dev/kvm and the TCG path; no
# AppArmorProfile until a profile is loaded; no ExecReload because the server
# has no SIGHUP handler).

LimitNOFILE=65536
TasksMax=16384
TimeoutStopSec=45
Restart=on-failure
RestartSec=5
KillMode=control-group

StandardOutput=journal
StandardError=journal
SyslogIdentifier=novacron-fabric-peer

[Install]
WantedBy=multi-user.target