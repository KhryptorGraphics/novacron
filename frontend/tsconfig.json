{
  "compilerOptions": {
    // Target and Library Configuration
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "ES2020"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    // Strict Type-Checking Options
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": false,
    "noUncheckedIndexedAccess": false,
    // Module Resolution Options
    "module": "esnext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@/components/*": [
        "src/components/*"
      ],
      "@/lib/*": [
        "src/lib/*"
      ],
      "@/hooks/*": [
        "src/hooks/*"
      ],
      "@/types/*": [
        "src/types/*"
      ],
      "@/utils/*": [
        "src/lib/utils/*"
      ]
    },
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    // Emit Options
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "removeComments": false,
    "noEmit": true,
    "importHelpers": true,
    "downlevelIteration": true,
    "isolatedModules": true,
    // JSX Options
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    // Advanced Options
    "incremental": true,
    "tsBuildInfoFile": ".next/cache/tsbuildinfo.json",
    "plugins": [
      {
        "name": "next"
      }
    ],
    // Additional Checks
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": false
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "jest.setup.js",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    ".next/dev/types/**/*.ts",
    ".next/dev/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "out",
    "dist",
    "cypress",
    "coverage",
    "src/__tests__",
    "src/tests",
    "tests",
    "src/components/mobile",
    "src/components/flows/MobileAppControls.tsx",
    "src/components/flows/PerformanceOptimizationFlow.tsx",
    "src/components/flows/UserSelfServicePortal.tsx",
    "src/components/flows/VMLifecycleFlow.tsx",
    "src/components/flows/index.ts",
    "src/components/monitoring/BandwidthMonitoringDashboard.tsx",
    "src/components/monitoring/PerformancePredictionDashboard.tsx",
    "src/components/monitoring/RealTimeMonitoringDashboard.tsx",
    "src/components/monitoring/SupercomputeFabricDashboard.tsx",
    "src/components/monitoring/OptimizedComponents.tsx",
    "src/components/ui/accessibility.tsx",
    "src/components/ui/advanced-form.tsx",
    "src/components/ui/keyboard-shortcuts.tsx",
    "src/components/ui/wizard.tsx"
  ],
  "ts-node": {
    "compilerOptions": {
      "module": "CommonJS"
    }
  }
}
