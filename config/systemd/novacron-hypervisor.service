[Unit]
Description=NovaCron standalone hypervisor node (backend/core/cmd/novacron)
Documentation=file:///opt/novacron/deploy/README.md
After=network-online.target
Wants=network-online.target
# StartLimit* belong to [Unit] (systemd >= 229).
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=novacron
Group=novacron
# qemu-system-* runs as a child of this unit and opens /dev/kvm (root:kvm 0660).
SupplementaryGroups=kvm
WorkingDirectory=/opt/novacron
# Optional: NOVACRON_AUTH_POSTGRES_URL / NOVACRON_AUTH_REDIS_URL for the
# node's own /api/auth/* persistence, NOVACRON_TRUSTED_PROXIES when a proxy
# fronts it. The binary's own settings are flags, not env.
EnvironmentFile=-/etc/novacron/hypervisor.env
# backend/core/cmd/novacron is flag-driven: -config (YAML, optional — defaults
# apply when the file is absent), -data-dir, -listen. -node-id defaults to the
# hostname. 9000 keeps this role off the control plane's 8090 and matches
# config.VMConfig.HypervisorAddrs' default "localhost:9000", which is what
# api-server dials to reach it. Health: GET /healthz (not /health).
ExecStart=/opt/novacron/bin/novacron-hypervisor \
  -config /etc/novacron/hypervisor.yaml \
  -data-dir /var/lib/novacron/vms \
  -listen 0.0.0.0:9000

# --- hardening that holds for this workload (see deploy/systemd/*.service) ---
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/novacron /var/log/novacron
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# --- deliberately absent: same list and reasons as deploy/systemd/novacron-api-server.service
# (qemu shares this cgroup, so no MemoryMax/CPUQuota; PrivateDevices and
# MemoryDenyWriteExecute would break /dev/kvm and the TCG path; no
# AppArmorProfile until a profile is loaded; no ExecReload because the server
# has no SIGHUP handler).

LimitNOFILE=65536
TasksMax=16384
TimeoutStopSec=45
Restart=on-failure
RestartSec=5
KillMode=control-group

StandardOutput=journal
StandardError=journal
SyslogIdentifier=novacron-hypervisor

[Install]
WantedBy=multi-user.target
